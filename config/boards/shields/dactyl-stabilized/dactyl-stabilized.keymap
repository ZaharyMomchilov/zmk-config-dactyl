 #include <behaviors.dtsi>
 #include <dt-bindings/zmk/keys.h>
 #include <dt-bindings/zmk/bt.h>
 #include <dt-bindings/zmk/outputs.h>
 
 / {
     keymap {
         compatible = "zmk,keymap";
 
         // TODO: SWAP SHIFTED KEYS SOMEHOW
         default_layer {
 // ------------------------------------------------------------------------------------------------------------
 // |  ESC  |  !  |  @  |   #  |   $   |   %   |   ^   |  |   &   |   *   |  (    |  )    |  -   |   +   |   `   |
 // |  TAB  |  Q  |  W  |   E  |   R   |   T   |   [   |  |   ]   |   Y   |  U    |  I    |  O   |   P   |   \   |
 // | SHIFT |  A  |  S  |   D  |   F   |   G   |   (   |  |   )   |   H   |  J    |  K    |  L   |   ;   |   '   |
 // |  CTRL |  Z  |  X  |   C  |   V   |   B   |       |  |       |   N   |  M    |  ,    |  .   |   /   | ENTER |
 //         | XXX | ALT |  GUI | ENTER | RAISE | LOWER |  | RAISE | LOWER | SPACE | BSPC  | UNDO |   DO  |
 //
             bindings = <
 &kp ESC    &kp EXCL &kp AT   &kp HASH &kp DOLLAR &kp PRCNT          &kp ASTRK &kp LPAR  &kp RPAR  &kp MINUS   &kp EQUAL   &kp GRAVE
 &kp TAB    &kp Q    &kp W    &kp E    &kp R      &kp T              &kp Y     &kp U     &kp I     &kp O       &kp P       &kp BSLH
 &kp LSHFT  &kp A    &kp S    &kp D    &kp F      &kp G              &kp H     &kp J     &kp K     &kp L       &kp SEMI    &kp SQT
 &kp LCTRL  &kp Z    &kp X    &kp C    &kp V      &kp B              &kp N     &kp M     &kp COMMA &kp DOT     &kp FSLH    &kp ENTER
 &kp LALT &kp LGUI &kp ENTER  &kp ENTER     &kp ENTER     &kp ENTER              &mo 1     &kp SPACE &kp BSPC  &kp LG(Z)   &kp LG(LS(Z)) &kp PRINTSCREEN
             >;
 
             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
         };
      };
     };
